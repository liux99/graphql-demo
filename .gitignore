# ---------------------------------------------------
# GLOBAL/SYSTEM FILES (Should apply to all projects)
# ---------------------------------------------------
.DS_Store
.vscode/
.idea/
.project
.classpath
*.iml
*.iws
*.swp
*~

# ---------------------------------------------------
# MAVEN / SPRING BOOT BACKEND
# ---------------------------------------------------

# Build & Compilation Artifacts
*/target/
!/target/classes/static  # Keep static resources if necessary, otherwise exclude /target

# Package Files (Already in your list, but good to include)
*.jar
*.war
*.nar
*.ear

# Logs and PID files
*.log
*.pid
/logs/

# Test and coverage reports
*/surefire-reports/
*/jacoco-output/
*/cobertura.ser

# Generated Sources (e.g., from GraphQL codegen)
/generated-sources/

# Class files
*.class

# JVM Crash Logs
hs_err_pid*
replay_pid*

# Spring Specific Configuration Files
# Configuration files that hold local passwords or keys
# Add only if they are for local environment variables/secrets
# application-local.properties
# application-local.yml


# ---------------------------------------------------
# NODE / REACT FRONTEND
# ---------------------------------------------------

# Node modules directory (Essential for React)
*/node_modules
*/build  # Standard output directory for React build (create-react-app)
*/dist   # Common output directory for Webpack/Vite

# Package Lock Files
# Use only the one corresponding to your package manager
package-lock.json # NPM
yarn.lock         # Yarn
pnpm-lock.yaml    # pnpm

# Environment Variables
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Coverage/Test reports
*/coverage